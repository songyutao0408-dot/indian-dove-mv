 "entries": [
  {
   "t": 0,
   "text": "印第安老斑鸠-周杰伦(JayChou)"
  },
  {
   "t": 8.95,
   "text": "词：方文山"
  },
  {
   "t": 17.91,
   "text": "曲：周杰伦"
  },
  {
   "t": 35.82,
   "text": "沙漠之中怎么会有泥鳅"
  },
  {
   "t": 37.83,
   "text": "话说完飞过一只海鸥"
  },
  {
   "t": 40.25,
   "text": ""
  },
  {
   "t": 40.81,
   "text": "大峡谷的风呼啸而过"
  },
  {
   "t": 44.1,
   "text": "是谁说没有"
  },
  {
   "t": 45.57,
   "text": "有一条热昏头的响尾蛇"
  },
  {
   "t": 48.1,
   "text": "无力的躺在干枯的河"
  },
  {
   "t": 50.65,
   "text": "在等待雨季来临变沼泽"
  },
  {
   "t": 55.31,
   "text": ""
  },
  {
   "t": 56.13,
   "text": "灰狼啃食着水鹿的骨头"
  },
  {
   "t": 58.24,
   "text": "秃鹰盘旋死盯着腐肉"
  },
  {
   "t": 60.85,
   "text": "草原上两只敌对野牛"
  },
  {
   "t": 64.56,
   "text": "在远方决斗"
  },
  {
   "t": 66.53,
   "text": "在一处被废弃的白蚁丘"
  },
  {
   "t": 68.58,
   "text": "站着一只饿昏的老斑鸠"
  },
  {
   "t": 72.02,
   "text": ""
  },
  {
   "t": 81.32,
   "text": "印地安老斑鸠腿短毛不多"
  },
  {
   "t": 83.79,
   "text": "几天都没有喝水也能活"
  },
  {
   "t": 86.62,
   "text": "脑袋瓜有一点秀逗"
  },
  {
   "t": 88.99,
   "text": "猎物死了它比谁都难过"
  },
  {
   "t": 91.43,
   "text": "印地安斑鸠会学人开口"
  },
  {
   "t": 94.05,
   "text": "仙人掌怕羞蜥蜴横着走"
  },
  {
   "t": 96.87,
   "text": "这里什么奇怪的事都有"
  },
  {
   "t": 99.53,
   "text": "包括像猫的狗"
  },
  {
   "t": 101.86,
   "text": "印地安老斑鸠平常话不多"
  },
  {
   "t": 104.32,
   "text": "除非是乌鸦抢了它的窝"
  },
  {
   "t": 107.14,
   "text": "它在灌木丛旁邂逅"
  },
  {
   "t": 109.34,
   "text": "一只令它心仪的母斑鸠"
  },
  {
   "t": 112.35,
   "text": ""
  },
  {
   "t": 137.69,
   "text": "牛仔红蕃在小镇背对背决斗"
  },
  {
   "t": 139.89,
   "text": "一只灰狼问候我谁是神枪手"
  },
  {
   "t": 142.7,
   "text": "巫师他念念有词地"
  },
  {
   "t": 143.8,
   "text": "对酋长下诅咒"
  },
  {
   "t": 144.55,
   "text": "还我骷髅头这故事"
  },
  {
   "t": 145.6,
   "text": "告诉我印地安的传说"
  },
  {
   "t": 146.78,
   "text": "还真是瞎透了什么都有"
  },
  {
   "t": 148.05,
   "text": "沙漠之中怎么会有泥鳅"
  },
  {
